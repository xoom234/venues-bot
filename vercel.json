{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt && cd webapp && npm ci",
  "buildCommand": "cd webapp && npm run build",
  "outputDirectory": "webapp/dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{.venv/**,__pycache__/**,**/*.pyc,.git/**,webapp/**,poll.py}"
    }
  },
  "crons": [
    {
      "path": "/api/cron_reset",
      "schedule": "0 20 1 * *"
    }
  ]
}

